              <div className="text-warmgray text-sm">

                <span className="text-base font-semibold text-ink">{fmt(currentMonthly * 12)}</span>

                <span className="ml-1">{t('per_year')}</span>

              </div>

            </div>

          </div>

        </div>

      </section>



      {/* ============ STEP 2: SUGGEST A PLAN ============ */}

      <section className="max-w-4xl mx-auto px-4 pt-10">

        <div className="flex items-center gap-3 mb-2">

          <span className="step-num">2</span>

          <h2 className="text-xl sm:text-2xl font-bold">{t('step2_title')}</h2>

        </div>

        <p className="text-sm text-warmgray ml-12 mb-4">{t('step2_hint')}</p>



        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">

          <div>

            <div className="text-[11px] uppercase tracking-wider mono text-warmgray mb-2 font-semibold">{t('postpaid_label')}</div>

            <select

              value={ppId}

              onChange={e => setPpId(e.target.value)}

              className="w-full p-3 border-2 border-ink/15 rounded-md bg-white text-base font-medium focus:border-airtelDeep focus:outline-none"

            >

              {POSTPAID_PLANS.map(p => (

                <option key={p.id} value={p.id}>

                  ₹{p.base} — {p.label}

                </option>

              ))}

            </select>

            <div className="text-[11px] text-warmgray mt-1.5">{POSTPAID_PLANS.find(p=>p.id===ppId)?.[lang==='hi'?'subHi':'subEn']}</div>

          </div>



          <div>

            <div className="text-[11px] uppercase tracking-wider mono text-warmgray mb-2 font-semibold">{t('wifi_label')}</div>

            <select

              value={wifiId}

              onChange={e => setWifiId(e.target.value)}

              className="w-full p-3 border-2 border-ink/15 rounded-md bg-white text-base font-medium focus:border-airtelDeep focus:outline-none"

            >

              {WIFI_PLANS.map(w => (

                <option key={w.id} value={w.id}>

                  ₹{w.base} — {w.speedLabel}{WIFI_INCLUDES_DTH.has(w.id) ? ' + DTH' : ''}

                </option>

              ))}

            </select>

            {wifiIncludesDTH && (

              <div className="text-[11px] text-sage mt-1.5 font-semibold">✓ {t('wifi_dth_included')}</div>

            )}

          </div>

        </div>



        <div className="summary-tile airtel">

          <div className="text-[11px] text-airtelDeep mono uppercase tracking-wider mb-2 font-semibold">{t('oap_disc_note')}</div>

          <div className="flex items-baseline justify-between gap-3 flex-wrap">

            <div className="text-sm font-semibold uppercase tracking-wider mono text-warmgray">{t('oap_label')}</div>

            <div className="flex items-baseline gap-4 tabular">

              <div>

                <span className="text-3xl sm:text-4xl font-bold text-airtelDeep">{fmt(oap ? oap.price : 0)}</span>

                <span className="text-warmgray text-sm ml-1">{t('per_month')}</span>

              </div>

              <div className="text-warmgray text-sm">

                <span className="text-base font-semibold text-ink">{fmt(oap ? oap.price * 12 : 0)}</span>

                <span className="ml-1">{t('per_year')}</span>

              </div>

            </div>

          </div>

        </div>

      </section>



      {/* ============ OPTIONAL PITCH MATH (collapsed) ============ */}

      {oap && pitchMath && (

        <section className="max-w-4xl mx-auto px-4 pt-6 no-print">

          <div className="text-[11px] mono uppercase tracking-wider text-warmgray font-semibold mb-3 ml-12">{t('pitch_math_header')}</div>



          <div className="flex flex-col gap-2 ml-12">



            {/* Per-SIM accordion */}

            <div className={`accordion-card ${expanded.persim ? 'open' : ''}`}>

              <button className="accordion-header" onClick={() => setExpanded({...expanded, persim: !expanded.persim})}>

                <span className="accordion-icon">▸</span>

                <div className="flex-1">

                  <div className="text-sm font-bold">{t('persim_title')}</div>

                  <div className="text-xs text-warmgray mt-0.5">{t('persim_preview')} <span className="text-airtelDeep font-bold tabular">{fmt(pitchMath.perSim)}</span> / SIM</div>

                </div>

              </button>

              {expanded.persim && (

                <div className="accordion-body">

                  <p className="text-sm text-warmgray mb-3 leading-relaxed">{t('persim_lede')}</p>

                  <div className="math-block">

                    <div>(<span className="math-em">{oap.pp.base}</span> × 1.18) − <span className="math-em">100</span></div>

                    <div>= {pitchMath.ppGST.toFixed(2)} − 100</div>

                    <div>= {(pitchMath.ppGST - 100).toFixed(2)}</div>

                    <div className="math-total">÷ <span className="math-em">{oap.pp.sims}</span> SIM{oap.pp.sims > 1 ? 's' : ''} = {fmt(pitchMath.perSim)} / SIM</div>

                  </div>

                  <div className="mt-3">

                    <div className="text-[11px] mono uppercase tracking-wider text-warmgray font-semibold mb-2">{t('persim_vs_label')}</div>

                    <div className="compare-row"><span className="label">{t('persim_vs_349')}</span><span className="value">{fmt(374)}</span></div>

                    <div className="compare-row"><span className="label">{t('persim_vs_449pre')}</span><span className="value">{fmt(481)}</span></div>

                    <div className="compare-row"><span className="label">{t('persim_vs_449pp')}</span><span className="value">{fmt(530)}</span></div>

                    <div className="compare-row highlight"><span className="label">{t('persim_this')}</span><span className="value">{fmt(pitchMath.perSim)}</span></div>

                  </div>

                  {pitchMath.persimVs349 > 0 && (

                    <div className="win-pill">✓ {t('persim_win')} {fmt(pitchMath.persimVs349)}</div>

                  )}

                </div>

              )}

            </div>



            {/* Wi-Fi accordion */}

            <div className={`accordion-card ${expanded.wifi ? 'open' : ''}`}>

              <button className="accordion-header" onClick={() => setExpanded({...expanded, wifi: !expanded.wifi})}>

                <span className="accordion-icon">▸</span>

                <div className="flex-1">

                  <div className="text-sm font-bold">{t('wifi_math_title')}</div>

                  <div className="text-xs text-warmgray mt-0.5">{t('wifi_preview')} <span className="text-airtelDeep font-bold tabular">{fmt(pitchMath.wifiEffective)}</span> / {lang==='hi' ? 'महीना' : 'mo'} ({oap.wifi.speedLabel})</div>

                </div>

              </button>

              {expanded.wifi && (

                <div className="accordion-body">

                  <p className="text-sm text-warmgray mb-3 leading-relaxed">{t('wifi_lede')}</p>

                  <div className="math-block">

                    <div>(<span className="math-em">{oap.wifi.base}</span> × 1.18) − <span className="math-em">100</span></div>

                    <div>= {pitchMath.wifiGST.toFixed(2)} − 100</div>

                    <div className="math-total">= {fmt(pitchMath.wifiEffective)} / {lang==='hi' ? 'महीना' : 'month'}</div>

                  </div>

                  <div className="mt-3">

                    <div className="text-[11px] mono uppercase tracking-wider text-warmgray font-semibold mb-2">{t('wifi_vs_label')}</div>

                    <div className="compare-row"><span className="label">{t('wifi_vs_standalone')} (₹{oap.wifi.base} × 1.18)</span><span className="value">{fmt(pitchMath.wifiGST)}</span></div>

                    <div className="compare-row highlight"><span className="label">{t('wifi_this')}</span><span className="value">{fmt(pitchMath.wifiEffective)}</span></div>

                  </div>

                  <div className="win-pill">✓ {t('wifi_win')}</div>

                </div>

              )}

            </div>



            {/* Bundle math accordion */}

            <div className={`accordion-card ${expanded.bundle ? 'open' : ''}`}>

              <button className="accordion-header" onClick={() => setExpanded({...expanded, bundle: !expanded.bundle})}>

                <span className="accordion-icon">▸</span>

                <div className="flex-1">

                  <div className="text-sm font-bold">{t('bundle_title')}</div>

                  <div className="text-xs text-warmgray mt-0.5">{t('bundle_preview')} <span className="text-airtelDeep font-bold tabular">{fmt(oap.price)}</span></div>

                </div>

              </button>

              {expanded.bundle && (

                <div className="accordion-body">

                  <div className="math-block">

                    <div><span className="label" style={{display:'inline-block',minWidth:'180px'}}>{t('bundle_wifi_base')}</span> <span className="math-em">{fmt(oap.wifi.base)}</span></div>

                    <div><span className="label" style={{display:'inline-block',minWidth:'180px'}}>{t('bundle_pp_base')}</span> <span className="math-em">{fmt(oap.pp.base)}</span></div>

                    <div style={{borderTop:'1px solid rgba(26,23,20,0.1)',marginTop:'4px',paddingTop:'4px'}}><span style={{display:'inline-block',minWidth:'180px'}}>{t('bundle_subtotal')}</span> {fmt(oap.wifi.base + oap.pp.base)}</div>

                    <div><span style={{display:'inline-block',minWidth:'180px'}}>{t('bundle_gst')}</span> {fmt((oap.wifi.base + oap.pp.base) * GST)}</div>

                    <div style={{color:'#BB0E1F'}}><span style={{display:'inline-block',minWidth:'180px'}}>{t('bundle_discount')}</span> − {fmt(OAP_DISCOUNT)}</div>

                    <div className="math-total"><span style={{display:'inline-block',minWidth:'180px'}}>{t('bundle_total')}</span> {fmt(oap.price)}</div>

                  </div>

                </div>

              )}

            </div>



          </div>

        </section>

      )}



      {/* ============ STEP 3: THE SAVINGS ============ */}

      <section className="max-w-4xl mx-auto px-4 pt-10">

        <div className="flex items-center gap-3 mb-4">

          <span className="step-num">3</span>

          <h2 className="text-xl sm:text-2xl font-bold">{lang==='hi' ? 'ये दिखाइए' : 'Show this to the customer'}</h2>

        </div>



        {!hasInputs ? (

          <div className="bg-cream2 border-2 border-dashed border-ink/15 rounded-lg p-8 text-center text-warmgray italic">

            {t('select_a_plan')}

          </div>

        ) : isPositive ? (

          <div className="savings-stamp">

            <div className="inner">

              <div className="text-[11px] mono uppercase tracking-[0.25em] opacity-80 mb-3">— {t('step3_savings').toUpperCase()}</div>

              <div className="text-lg sm:text-xl opacity-90 mb-2">{t('step3_save')}</div>

              <div className="display">{fmt(yearlySavings)}</div>

              <div className="text-lg sm:text-xl opacity-90 mt-2">{t('step3_year')}</div>

              <div className="mt-4 pt-4 border-t border-white/20 text-sm opacity-80">

                ({fmt(monthlySavings)} {t('per_month')})

              </div>

              {oapBenefitsValue > 0 && (

                <div className="mt-5 pt-5 border-t border-white/20">

                  <div className="text-[12px] uppercase tracking-wider opacity-80 mb-1">{t('step3_includes')}</div>

                  <div className="text-3xl sm:text-4xl font-bold tabular">{fmt(oapBenefitsValue)}<span className="text-base opacity-80 ml-1">{t('step3_includes_2')}</span></div>

                </div>

              )}

              {(xfeName.trim() || xfePhone.trim()) && (

                <div className="mt-5 pt-4 border-t border-white/20 text-sm">

                  <div className="opacity-75 text-[11px] uppercase tracking-wider mb-1">{t('your_rep')}</div>

                  <div className="font-bold text-base tracking-wide">

                    {xfeName.trim() && <span>{xfeName}</span>}

                    {xfeName.trim() && xfePhone.trim() && <span className="opacity-60 mx-2">·</span>}

                    {xfePhone.trim() && <span className="tabular">{xfePhone}</span>}

                  </div>

                </div>

              )}

            </div>

          </div>

        ) : (

          <div className="upsell-stamp">

            <div className="inner">

              <div className="text-[11px] mono uppercase tracking-[0.25em] opacity-70 mb-3 text-gold">— SMART UPGRADE</div>

              <div className="text-lg sm:text-xl opacity-90 mb-2">{t('step3_upsell_pre')}</div>

              <div className="display">{fmt(Math.abs(monthlySavings))}</div>

              <div className="text-lg sm:text-xl opacity-90 mt-2">{t('step3_upsell_post')}</div>

              {oapBenefitsValue > Math.abs(monthlySavings) && (

                <div className="mt-5 pt-5 border-t border-white/15">

                  <div className="text-[12px] uppercase tracking-wider opacity-70 mb-1">{t('step3_upsell_note')}</div>

                  <div className="text-3xl sm:text-4xl font-bold tabular text-gold">{fmt(oapBenefitsValue)}</div>

                  <div className="text-sm opacity-80 mt-1">{t('step3_upsell_swap')}</div>

                </div>

              )}

              {(xfeName.trim() || xfePhone.trim()) && (

                <div className="mt-5 pt-4 border-t border-white/15 text-sm">

                  <div className="opacity-75 text-[11px] uppercase tracking-wider mb-1">{t('your_rep')}</div>

                  <div className="font-bold text-base tracking-wide text-gold">

                    {xfeName.trim() && <span>{xfeName}</span>}

                    {xfeName.trim() && xfePhone.trim() && <span className="opacity-60 mx-2">·</span>}

                    {xfePhone.trim() && <span className="tabular">{xfePhone}</span>}

                  </div>

                </div>

              )}

            </div>

          </div>

        )}



        {/* Freebies — DTH (if applicable) + OTT list (toggleable) */}

        {oap && (oap.benefits.length > 0 || wifiIncludesDTH) && (

          <div className="mt-6">

            <div className="flex items-baseline justify-between flex-wrap gap-2 mb-2">

              <div className="text-[11px] mono uppercase tracking-wider text-warmgray font-semibold">{t('step3_freebies')}</div>

              <div className="text-[11px] text-warmgray italic no-print">{t('ott_customize_hint')}</div>

            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">

              {wifiIncludesDTH && (

                <div className="dth-benefit-row">

                  <span className="dth-check">✓</span>

                  <span className="font-semibold flex-1">{t('dth_replaces_tv')}</span>

                  <span className="text-[10px] mono uppercase tracking-wider text-warmgray">{t('lifetime')}</span>

                  <span className="font-bold tabular text-sm" style={{color:'#5C7C57'}}>{t('dth_included_short')}</span>

                </div>

              )}

              {oap.benefits.map(b => {

                const off = !!ottDisabled[b.id];

                return (

                  <div

                    key={b.id}

                    onClick={() => setOttDisabled({ ...ottDisabled, [b.id]: !off })}

                    className={`benefit-row ott-toggle-row ${off ? 'disabled' : ''}`}

                  >

                    <span className={`ott-check ${off ? '' : 'on'}`}>

                      {!off && <span style={{fontSize:'14px',fontWeight:700,lineHeight:1}}>✓</span>}

                    </span>

                    <span className="font-semibold flex-1 ott-name-label">{b.name}</span>

                    <span className="text-[10px] mono uppercase tracking-wider text-warmgray">

                      {b.duration === 'lifetime' ? t('lifetime') : b.duration.replace('M', t('suffix_m'))}

                    </span>

                    <span className="text-airtelDeep font-bold tabular text-sm">{fmt(b.value)}/mo</span>

                  </div>

                );

              })}

            </div>

            {/* Effective benefits summary, only if some are toggled off */}

            {enabledOttCount < oap.benefits.length && (

              <div className="mt-3 p-3 bg-cream2 border border-ink/10 rounded-md flex items-baseline justify-between flex-wrap gap-2">

                <div>

                  <div className="text-[10px] mono uppercase tracking-wider text-warmgray">{t('ott_effective')}</div>

                  <div className="text-2xl font-bold tabular text-airtelDeep mt-0.5">{fmt(enabledOttValue)}<span className="text-sm text-warmgray font-normal ml-1">/mo</span></div>

                </div>

                <div className="text-xs text-warmgray">{enabledOttCount} {t('ott_of')} {oap.benefits.length} {t('ott_kept')}</div>

              </div>

            )}

          </div>

        )}



        {/* Actions */}

        {!submitted ? (

          <>

            <div className="mt-8 flex flex-wrap gap-3 no-print">

              <button

                onClick={submitToSheet}

                disabled={submitting || !hasInputs || !xfePhone.trim() || !xfeName.trim()}

                className="px-5 py-3 bg-airtelDeep text-cream rounded-md font-semibold text-sm hover:bg-airtel transition disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"

              >

                {submitting ? (

                  <>⏳ {t('submitting')}</>

                ) : (

                  <>📤 {t('submit_btn')}</>

                )}

              </button>

              <button

                onClick={reset}

                className="px-5 py-3 border border-ink/20 rounded-md font-semibold text-sm hover:bg-cream2 transition"

              >

                ↻ {t('reset')}

              </button>

            </div>

          </>

        ) : (

          <div className="no-print mt-8 bg-sage/10 border-2 border-sage rounded-lg p-5">

            <div className="flex items-center gap-2 text-sage font-bold text-base mb-2">

              <span className="text-2xl">✓</span>

              <span>{t('submitted_msg')}</span>

            </div>

            <div className="flex flex-wrap gap-3 mt-4">

              <button

                onClick={() => window.print()}

                className="px-5 py-3 bg-airtelDeep text-cream rounded-md font-semibold text-sm hover:bg-airtel transition flex items-center gap-2"

              >

                📄 {t('save_pdf_btn')}

              </button>

              <button

                onClick={reset}

                className="px-5 py-3 border border-ink/20 rounded-md font-semibold text-sm hover:bg-cream2 transition"

              >

                ↻ {t('reset')}

              </button>

            </div>

            <p className="text-[12px] text-warmgray italic mt-3">{t('screenshot_hint')}</p>

          </div>

        )}

      </section>



      <footer className="max-w-4xl mx-auto px-4 mt-12 pt-6 border-t border-ink/10 text-[11px] text-warmgray mono uppercase tracking-wider no-print">

        One Airtel · v5 · per-SIM × count · DTH-aware · GST inclusive

      </footer>



    </div>

  );

}



/* ============================================================

   CONNECTION ROW (one for Mobile, WiFi, TV — has Airtel + Others)

   ============================================================ */



function ConnRow({ label, airtelRow, othersRow, sideAirtel, sideOthers, onUpdate, onToggleGst, airtelKey, othersKey }) {

  return (

    <div className="conn-row">

      <div className="conn-cat">{label}</div>

      <div className="conn-sides">

        <SubRow side="a" sideLabel={sideAirtel} row={airtelRow} onUpdate={onUpdate} accent="airtel"

          onToggleGst={() => onToggleGst(airtelKey)} />

        <SubRow side="o" sideLabel={sideOthers} row={othersRow} onUpdate={onUpdate}

          onToggleGst={() => onToggleGst(othersKey)} />

      </div>

    </div>

  );

}



function SubRow({ side, sideLabel, row, onUpdate, accent, onToggleGst }) {

  const base = (parseFloat(row.count) || 0) * (parseFloat(row.perMonth) || 0);

  const total = row.gst ? base * 1.18 : base;

  const hasValues = base > 0;

  return (

    <div className="conn-subrow">

      <div className={`label-side ${accent === 'airtel' ? 'text-airtelDeep' : ''}`}>{sideLabel}</div>

      <input

        type="number"

        inputMode="numeric"

        placeholder="0"

        value={row.count}

        onChange={e => onUpdate(side, 'count', e.target.value)}

      />

      <input

        type="number"

        inputMode="decimal"

        placeholder="₹"

        value={row.perMonth}

        onChange={e => onUpdate(side, 'perMonth', e.target.value)}

      />

      <div style={{display:'flex',flexDirection:'column',alignItems:'flex-end',gap:'3px'}}>

        <div className={`total-cell ${total === 0 ? 'zero' : ''}`}>

          {total > 0 ? fmt(total) : '—'}

        </div>

        {hasValues && (

          <button

            type="button"

            onClick={onToggleGst}

            title={row.gst ? 'Remove GST' : 'Add 18% GST'}

            style={{

              fontSize:'9px',

              fontFamily:'ui-monospace,monospace',

              fontWeight:700,

              letterSpacing:'0.06em',

              textTransform:'uppercase',

              padding:'1px 5px',

              borderRadius:'3px',

              border: row.gst ? '1px solid #BB0E1F' : '1px solid rgba(26,23,20,0.2)',

              background: row.gst ? '#BB0E1F' : 'transparent',

              color: row.gst ? '#FAF6EE' : '#6B5F52',

              cursor:'pointer',

              transition:'all 0.15s ease',

              whiteSpace:'nowrap',

            }}

          >

            {row.gst ? '+GST ✓' : '+GST'}

          </button>

        )}

      </div>

    </div>

  );

}



ReactDOM.createRoot(document.getElementById('root')).render(<App />);

</script>



</body>

</html>
