const fmt      = n => '₹' + Math.round(n).toLocaleString('en-IN');

const fmtPlain = n => Math.round(n).toLocaleString('en-IN');

const parseNum = v => { const n = parseFloat(v); return isFinite(n) ? n : 0; };



function buildOAP(wifiId, postpaidId) {

  const wifi = WIFI_PLANS.find(w => w.id === wifiId);

  const pp   = POSTPAID_PLANS.find(p => p.id === postpaidId);

  if (!wifi || !pp) return null;

  const price = (wifi.base + pp.base) * GST - OAP_DISCOUNT;

  // Merge OTT inclusions, picking longer duration when both have it

  const order = { lifetime: 99, '12M': 12, '6M': 6, '3M': 3, '1M': 1 };

  const wOtt = WIFI_OTT[wifiId] || {};

  const pOtt = POSTPAID_OTT[postpaidId] || {};

  const merged = {};

  for (const k of new Set([...Object.keys(wOtt), ...Object.keys(pOtt)])) {

    const a = wOtt[k], b = pOtt[k];

    merged[k] = (order[a] || 0) >= (order[b] || 0) ? (a || b) : (b || a);

  }

  const benefits = Object.entries(merged)

    .filter(([k]) => OTT[k])

    .map(([k, dur]) => ({ id: k, name: OTT[k].name, value: OTT[k].value, duration: dur }))

    .sort((a, b) => b.value - a.value);

  return { wifi, pp, price, benefits, includesDTH: WIFI_INCLUDES_DTH.has(wifiId) };

}



